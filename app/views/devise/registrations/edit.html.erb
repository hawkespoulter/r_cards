<div class="new-game-wrapper">
  <div class="new-game-card">
    <h2>Edit Profile</h2>

    <%= form_with url: update_name_path, method: :patch do %>
      <div class="form-group">
        <%= label_tag "user_name", "Display Name" %>
        <%= text_field_tag "user[name]", current_user.name, autofocus: true, autocomplete: "name", class: "form-input" %>
      </div>
      <%= submit_tag "Update Name", class: "btn-create" %>
    <% end %>

    <div style="margin:24px 0;padding-top:20px;border-top:1px solid rgba(255,255,255,0.1);"></div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "email", class: "form-input" %>
        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <span style="font-size:0.75rem;opacity:0.6;">Awaiting confirmation for: <%= resource.unconfirmed_email %></span>
        <% end %>
      </div>

      <div class="form-group">
        <%= f.label :password %>
        <span style="font-size:0.75rem;opacity:0.55;margin-left:6px;">(leave blank to keep current)</span>
        <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :current_password %>
        <span style="font-size:0.75rem;opacity:0.55;margin-left:6px;">(required to save changes)</span>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input" %>
      </div>

      <%= f.submit "Save Changes", class: "btn-create" %>
    <% end %>

    <div style="margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.1);">
      <p style="font-size:0.8rem;opacity:0.5;margin:0 0 10px;text-transform:uppercase;letter-spacing:0.08em;">Danger Zone</p>
      <%= button_to "Delete Account", registration_path(resource_name),
            data: { turbo_confirm: "Are you sure? This cannot be undone." },
            method: :delete,
            class: "btn-quit",
            style: "width:100%;border-radius:6px;padding:8px;" %>
    </div>

    <div style="margin-top:16px;text-align:center;font-size:0.875rem;opacity:0.65;">
      <%= link_to "Back", :back %>
    </div>
  </div>
</div>
