<% seven         = @lucky_seven %>
<% finished_ids  = seven&.finished_player_ids || [] %>
<% knocked_ids   = seven&.knocked_ids || [] %>
<% all_players   = (@players + [@current_player]).compact.sort_by(&:id) %>
<% is_me_finished = finished_ids.include?(@current_player&.id) %>
<% my_turn       = @game_started && !seven&.game_over? && @game.current_turn == @current_player&.id && !is_me_finished %>
<% playable      = my_turn ? seven.playable_cards(@current_player).uniq : [] %>

<% content_for :nav_center do %>
  <%= render "nav_game_info", game: @game, canasta: nil, current_player: @current_player, game_started: @game_started, is_host: @is_host, my_turn: my_turn,
        show_settings_trigger: false, finished_ids: finished_ids, passed_ids: knocked_ids,
        passed_label: "Knocked", rankings: (seven&.rankings || []) %>
<% end %>

<div class="game-container <%= 'my-turn' if my_turn %>" id="game-container" data-game-id="<%= @game.id %>">

  <% if seven&.game_over? %>

    <div class="game-over">
      <h2>🏆 <%= seven.rankings.first&.dig(:name) %> wins!</h2>
      <ol class="rankings-list">
        <% seven.rankings.each do |r| %>
          <li>
            <span class="ranking-title"><%= r[:title] %></span>
            <span>
              <%= r[:name] %>
              <% if r[:player_id] == @current_player&.id %>
                <span class="ranking-you">(you)</span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ol>
      <div class="game-over-actions">
        <%= link_to 'Back to Lobby', games_path, class: 'btn-quit', style: 'display:inline-block;padding:10px 24px;border-radius:6px;text-decoration:none;' %>
      </div>
    </div>

  <% elsif @game_started %>

    <div class="seven-table">
      <% LuckySeven::SUITS.each do |suit| %>
        <% row    = seven.layout_row(suit) %>
        <% values = row.keys.map(&:to_i) %>
        <div class="seven-track" data-suit="<%= suit %>">
          <span class="seven-track-suit seven-suit-<%= suit %>"><%= LuckySeven::SUIT_SYMBOLS[suit] %></span>
          <div class="seven-slots">
            <% (1..13).each do |value| %>
              <% copies = seven.copies_played(suit, value) %>
              <%
                code  = seven_card_code(suit, value)
                state = if copies.positive?
                          "filled"
                        elsif !seven.started?
                          # Nothing but the ♦7 can be played until it opens.
                          code == LuckySeven::STARTING_CARD ? "next" : "empty"
                        elsif values.empty?
                          value == LuckySeven::ANCHOR ? "next" : "empty"
                        elsif value == values.min - 1 || value == values.max + 1
                          "next"
                        else
                          "empty"
                        end
              %>
              <div class="seven-slot seven-slot-<%= state %> <%= 'seven-slot-mine' if playable.include?(code) %>"
                   data-slot-card="<%= code %>">
                <% if copies.positive? %>
                  <%= image_tag "cards/#{card_asset(code)}.svg", class: "seven-slot-card" %>
                  <% if copies > 1 %>
                    <span class="seven-slot-copies">×<%= copies %></span>
                  <% end %>
                <% else %>
                  <span class="seven-slot-label"><%= seven_rank_label(value) %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# No one can be finished here — the first player out ends the game, which
        renders the results screen above instead. %>
    <div class="hand-container">
      <p class="hand-label">Your hand</p>
      <div class="seven-hand-row">
        <% @current_player.hand.each_with_index do |card, i| %>
          <div class="hand-card-wrap <%= playable.include?(card) ? 'seven-playable' : 'seven-blocked' %>"
               draggable="<%= playable.include?(card) %>"
               data-card="<%= card %>" data-hand-index="<%= i %>">
            <%= image_tag "cards/#{card_asset(card)}.svg", class: "game-card", draggable: "false" %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Submitted by lucky_seven_cards.js — a card is played by dropping it on
        its slot or, on touch, tapping the card and then the slot. Same hidden
        form pattern canasta uses for meld/discard/red-three. %>
    <% if my_turn %>
      <%= form_with url: play_cards_game_path(@game), method: :post,
            html: { id: "play-form", style: "display:none;" } do |f| %>
        <%= f.hidden_field :cards, id: "selected-cards-input", value: "" %>
      <% end %>
    <% end %>

  <% else %>

    <div class="pregame">
      <p>Waiting for players to join…</p>
      <p class="waiting-hint">
        <%= all_players.length %> in — dealing
        <%= LuckySeven.deck_count_for(all_players.length) %>
        deck<%= "s" if LuckySeven.deck_count_for(all_players.length) > 1 %>.
        A second deck joins at 6 players, a third at 11.
      </p>
      <% if all_players.length < 2 %>
        <p>You need at least 2 players to start.</p>
      <% end %>
      <% if @is_host %>
        <%= button_to 'Start Game', start_game_path(@game), method: :post,
              class: 'btn-start',
              disabled: all_players.length < 2 %>
      <% else %>
        <p style="opacity:0.5;font-size:0.9rem;">Waiting for the host to start the game…</p>
      <% end %>
    </div>

  <% end %>

</div>
