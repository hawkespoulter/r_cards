<% seven         = @lucky_seven %>
<% finished_ids  = seven&.finished_player_ids || [] %>
<% knocked_ids   = seven&.knocked_ids || [] %>
<% all_players   = (@players + [@current_player]).compact.sort_by(&:id) %>
<% is_me_finished = finished_ids.include?(@current_player&.id) %>
<% my_turn       = @game_started && !seven&.game_over? && @game.current_turn == @current_player&.id && !is_me_finished %>
<% playable      = my_turn ? seven.playable_cards(@current_player).uniq : [] %>
<%# Out of turn every card can still be picked up and thrown at the table — the
    server answers with a "not your turn" popup, which beats a hand that quietly
    refuses to respond. On your turn only legal cards lift. %>
<% attemptable   = my_turn ? playable : (@current_player&.hand || []) %>

<% content_for :nav_center do %>
  <%= render "nav_game_info", game: @game, canasta: nil, current_player: @current_player, game_started: @game_started, is_host: @is_host, my_turn: my_turn,
        show_settings_trigger: false, finished_ids: finished_ids, passed_ids: knocked_ids,
        passed_label: "Knocked", rankings: (seven&.rankings || []) %>
<% end %>

<div class="game-container <%= 'my-turn' if my_turn %>" id="game-container"
     data-game-id="<%= @game.id %>" data-my-turn="<%= my_turn %>"
     data-player-id="<%= @current_player&.id %>">

  <% if seven&.game_over? %>

    <div class="game-over">
      <h2>🏆 <%= seven.rankings.first&.dig(:name) %> wins!</h2>
      <ol class="rankings-list">
        <% seven.rankings.each do |r| %>
          <li>
            <span class="ranking-title"><%= r[:title] %></span>
            <span>
              <%= r[:name] %>
              <% if r[:player_id] == @current_player&.id %>
                <span class="ranking-you">(you)</span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ol>
      <div class="game-over-actions">
        <% if @is_host %>
          <%= button_to 'Play Again', start_round_game_path(@game), method: :post, class: 'btn-start' %>
        <% else %>
          <p class="waiting-hint">Waiting for the host to deal again…</p>
        <% end %>
        <%= link_to 'Back to Lobby', games_path, class: 'btn-quit', style: 'display:inline-block;padding:10px 24px;border-radius:6px;text-decoration:none;' %>
      </div>
    </div>

  <% elsif @game_started %>

    <%# Four spots, one per suit, but which suit lands in which is up to whoever
        plays the 7 — the rows carry no suit identity until then. Cards other
        than the 7 fan out sideways from it and overlap, so a run condenses the
        way a canasta meld does instead of reserving a slot per rank. %>
    <div class="seven-board">
      <% (0...LuckySeven::ROWS).each do |row_index| %>
        <% suit = seven.row_suit(row_index) %>
        <div class="seven-row <%= suit ? 'seven-row-open' : 'seven-row-empty' %>"
             data-row="<%= row_index %>" data-suit="<%= suit %>">
          <% if suit %>
            <%# The low run fans leftward, so its stacking is the reverse of DOM
                order — the outermost card sits on top, matching the high run. %>
            <div class="seven-run seven-run-low">
              <% seven.run_cards(suit, high: false).each_with_index do |(code, copies), i| %>
                <div class="seven-run-card" style="z-index: <%= 20 - i %>;">
                  <%= image_tag "cards/#{card_asset(code)}.svg", class: "seven-run-img" %>
                  <% if copies > 1 %><span class="seven-copies">×<%= copies %></span><% end %>
                </div>
              <% end %>
            </div>

            <div class="seven-anchor">
              <%= image_tag "cards/#{card_asset(seven.seven_code(suit, LuckySeven::ANCHOR))}.svg", class: "seven-anchor-img" %>
              <% anchor_copies = seven.copies_played(suit, LuckySeven::ANCHOR) %>
              <% if anchor_copies > 1 %><span class="seven-copies">×<%= anchor_copies %></span><% end %>
            </div>

            <div class="seven-run seven-run-high">
              <% seven.run_cards(suit, high: true).each do |code, copies| %>
                <div class="seven-run-card">
                  <%= image_tag "cards/#{card_asset(code)}.svg", class: "seven-run-img" %>
                  <% if copies > 1 %><span class="seven-copies">×<%= copies %></span><% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="seven-run seven-run-low"></div>
            <div class="seven-anchor seven-anchor-open"><span class="seven-anchor-hint">7</span></div>
            <div class="seven-run seven-run-high"></div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# No one can be finished here — the first player out ends the game, which
        renders the results screen above instead. %>
    <div class="hand-container">
      <div class="seven-hand-row">
        <% @current_player.hand.each_with_index do |card, i| %>
          <div class="hand-card-wrap <%= attemptable.include?(card) ? 'seven-playable' : 'seven-blocked' %>"
               draggable="<%= attemptable.include?(card) %>"
               data-card="<%= card %>" data-hand-index="<%= i %>">
            <%= image_tag "cards/#{card_asset(card)}.svg", class: "game-card", draggable: "false" %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Submitted by lucky_seven_cards.js — a card is played by dropping it on
        its row or, on touch, tapping the card and then the row. Same hidden
        form pattern canasta uses for meld/discard/red-three. Rendered out of
        turn too, so an out-of-turn attempt has something to submit and can come
        back with the popup. %>
    <%= form_with url: play_cards_game_path(@game), method: :post,
          html: { id: "play-form", style: "display:none;" } do |f| %>
      <%= f.hidden_field :cards, id: "selected-cards-input", value: "" %>
      <%= f.hidden_field :row, id: "selected-row-input", value: "" %>
    <% end %>

  <% else %>

    <div class="pregame">
      <p>Waiting for players to join…</p>
      <p class="waiting-hint">
        <%= all_players.length %> in — one deck dealt out between you,
        so the more players the shorter the hands.
      </p>
      <% if all_players.length < 2 %>
        <p>You need at least 2 players to start.</p>
      <% end %>
      <% if @is_host %>
        <%= button_to 'Start Game', start_game_path(@game), method: :post,
              class: 'btn-start',
              disabled: all_players.length < 2 %>
      <% else %>
        <p style="opacity:0.5;font-size:0.9rem;">Waiting for the host to start the game…</p>
      <% end %>
    </div>

  <% end %>

</div>
