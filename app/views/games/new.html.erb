<div class="new-game-wrapper">
  <div class="new-game-card">
    <h2>♠ New Game</h2>

    <%= form_with model: @game, data: { turbo: false } do |form| %>
      <% if @game.errors.any? %>
        <div class="alert" style="margin-bottom: 16px;">
          <% @game.errors.full_messages.each do |msg| %>
            <div><%= msg %></div>
          <% end %>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :game_type, "Game Type" %>
        <%= form.select :game_type,
              Game.game_types.keys.map { |t| [t.titleize, t] },
              {},
              { id: "game-type-select" } %>
      </div>

      <div class="settings-section" id="scum-settings" style="display:none;">
        <p class="settings-heading">Scum Settings</p>

        <label class="toggle-label">
          <%= form.check_box :pass_locks_out, class: "toggle-input" %>
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span class="toggle-text">
            Pass locks you out until end of round
            <span class="toggle-hint">Passing skips you for the rest of the round until the pile clears.</span>
          </span>
        </label>
        <label class="toggle-label" style="margin-top: 12px;">
          <%= form.check_box :leader_can_continue, class: "toggle-input" %>
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span class="toggle-text">
            Leader can continue after everyone passes
            <span class="toggle-hint">When everyone passes, the leader may play higher on their own pile or pass to clear it.</span>
          </span>
        </label>
      </div>

      <div class="settings-section" id="canasta-settings" style="display:none;">
        <p class="settings-heading">Canasta Settings</p>
        <p class="toggle-hint">Canasta needs exactly 4 players, seated into 2 fixed teams.</p>

        <label class="toggle-label">
          <%= form.check_box :florida_rules, class: "toggle-input" %>
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span class="toggle-text">
            Florida Rules
            <span class="toggle-hint">15-card hands instead of 13, plus an extra joker per deck.</span>
          </span>
        </label>
      </div>

      <div class="settings-section" id="lucky-seven-settings" style="display:none;">
        <p class="settings-heading">Lucky Seven Settings</p>
        <p class="toggle-hint">
          Build each suit out from its 7, aces low. The ♦7 opens the game and the
          first player to empty their hand wins. Capping a run with an ace or a
          king earns another card. One deck, dealt out between everyone playing.
        </p>
      </div>

      <%= form.submit "Create Game", class: "btn-create" %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function () {
    const select      = document.getElementById("game-type-select");
    const scumOpts    = document.getElementById("scum-settings");
    const canastaOpts = document.getElementById("canasta-settings");
    const sevenOpts   = document.getElementById("lucky-seven-settings");
    if (!select) return;

    function updateSettings() {
      if (scumOpts)    scumOpts.style.display    = select.value === "scum"        ? "block" : "none";
      if (canastaOpts) canastaOpts.style.display = select.value === "canasta"     ? "block" : "none";
      if (sevenOpts)   sevenOpts.style.display   = select.value === "lucky_seven" ? "block" : "none";
    }

    select.addEventListener("change", updateSettings);
    updateSettings();
  });
</script>
