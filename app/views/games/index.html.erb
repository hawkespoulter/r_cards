<div class="lobby-header">
  <h1>♠ Game Lobby</h1>
  <%= link_to 'New Game', new_game_path, class: 'btn' %>
</div>

<div class="grid-container">
  <% @games.each do |game| %>
    <%= render partial: 'game_lobby_card', locals: { game: game, players: game.players } %>
  <% end %>
  <% if @games.empty? %>
    <p style="padding: 0 24px; opacity: 0.6;">No games yet — create one!</p>
  <% end %>
</div>
