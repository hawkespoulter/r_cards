<div class="flex flex-col">
  <h1 class="text-3xl font-bold underline">Games</h1>
  <%= link_to 'New Game', new_game_path, class: 'btn btn-primary' %>

  <div class="p-4 flex flex-row flex-wrap" id="game-updates">
    <% @games.each do |game| %>
      <%= render partial: 'game_lobby_card', locals: {game: game} %>
    <% end %>
  </div>

  <div id="game-updates"></div>
</div>
