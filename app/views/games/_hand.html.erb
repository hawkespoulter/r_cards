<div class="hand">
  <% hand.each do |rank_group| %>
    <div class="rank" draggable="true" data-cards="<%= rank_group.to_json %>">
      <% rank_group.each do |card| %>
        <%= image_tag "cards/#{card_asset(card)}.svg", class: "game-card", draggable: "false", data: { card: card } %>
      <% end %>
    </div>
  <% end %>
</div>
