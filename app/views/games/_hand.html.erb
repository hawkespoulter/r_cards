<div class="current-player">Butt: <%= @current_player.hand %></div>

<div class="hand">
  <% @current_player.hand.each do |rank| %>
    <div class="rank">
      <% rank.each do |card| %>
        <%= image_tag "cards/#{card}.svg", class: "game-card", data: { card: card } %>
      <% end %>
    </div>
  <% end %>
</div>