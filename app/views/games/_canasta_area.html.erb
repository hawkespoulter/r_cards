<%# locals: team_num (integer 0/1), melds (hash rank=>cards), red_threes (array), opponent (bool) %>
<% opponent ||= false %>
<% completed = sort_melds(melds.select { |_rank, cards| cards.length >= 7 }) %>
<% in_progress = sort_melds(melds.reject { |_rank, cards| cards.length >= 7 }) %>
<% has_anything = completed.any? || red_threes.any? || in_progress.any? %>

<% if has_anything %>
  <% if opponent %>
    <%# ── Opponent layout: [in-progress melds] on left, [canastas / red-threes] stacked on right ── %>
    <div class="canasta-area canasta-area-opponent">

      <% if in_progress.any? %>
        <div class="canasta-melds-row">
          <% in_progress.each do |rank, cards| %>
            <div class="meld-group">
              <% cards.each do |card| %>
                <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card meld-card" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if red_threes.any? || completed.any? %>
        <div class="canasta-opponent-right">
          <% if completed.any? %>
            <div class="canasta-completed-row">
              <% completed.each_with_index do |(rank, cards), idx| %>
                <% rep = canasta_representative_card(rank, cards) %>
                <% clean = canasta_clean?(cards) %>
                <div class="canasta-single <%= clean ? 'canasta-clean' : 'canasta-dirty' %> <%= idx.odd? ? 'canasta-horizontal' : 'canasta-vertical' %>">
                  <%= image_tag "cards/#{canasta_card_asset(rep)}.svg", class: "game-card canasta-rep-card" %>
                  <span class="canasta-badge"><%= clean ? "♦ Clean" : "♠ Dirty" %></span>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if red_threes.any? %>
            <div class="canasta-completed-row">
              <% red_threes.each do |card| %>
                <div class="canasta-single red-three-single">
                  <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card canasta-rep-card" %>
                  <span class="canasta-badge">Red 3</span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>

  <% else %>
    <%# ── My team layout: [red threes | completed canastas] on top, [in-progress melds] below ── %>
    <div class="canasta-area">

      <% if red_threes.any? || completed.any? %>
        <div class="canasta-completed-row">
          <% red_threes.each do |card| %>
            <div class="canasta-single red-three-single">
              <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card canasta-rep-card" %>
              <span class="canasta-badge">Red 3</span>
            </div>
          <% end %>

          <% completed.each_with_index do |(rank, cards), idx| %>
            <% rep = canasta_representative_card(rank, cards) %>
            <% clean = canasta_clean?(cards) %>
            <div class="canasta-single <%= clean ? 'canasta-clean' : 'canasta-dirty' %> <%= idx.odd? ? 'canasta-horizontal' : 'canasta-vertical' %>">
              <%= image_tag "cards/#{canasta_card_asset(rep)}.svg", class: "game-card canasta-rep-card" %>
              <span class="canasta-badge"><%= clean ? "♦ Clean" : "♠ Dirty" %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if in_progress.any? %>
        <div class="canasta-melds-row">
          <% in_progress.each do |rank, cards| %>
            <div class="meld-group">
              <% cards.each do |card| %>
                <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card meld-card" %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

    </div>
  <% end %>
<% end %>
