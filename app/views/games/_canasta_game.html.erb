<% my_team       = @current_player&.team %>
<% teammate      = my_team && @game.players.where(team: my_team).where.not(id: @current_player&.id).first %>
<% opponents     = my_team ? @game.players.where.not(team: my_team) : [] %>
<% my_turn       = @game_started && @canasta && !@canasta.game_over? && @game.current_turn == @current_player&.id %>
<% turn_phase    = @canasta&.turn_phase %>

<% other_players = @game.players.where.not(id: @current_player&.id).order(:id).to_a %>
<% peak_left  = other_players[0] %>
<% peak_top   = other_players[1] %>
<% peak_right = other_players[2] %>

<div class="game-container <%= 'my-turn' if my_turn %>" data-game-id="<%= @game.id %>" data-player-id="<%= @current_player&.id %>">

  <header class="game-header">
    <div class="game-title">♣ Canasta<%= " (Florida Rules)" if @game.florida_rules? %></div>

    <div class="players-list">
      <% [0, 1].each do |team| %>
        <div class="team-score-chip <%= 'my-team' if team == my_team %>">
          Team <%= team + 1 %><%= " (you)" if team == my_team %> —
          <%= ((@canasta&.team_scores || {})[team.to_s] || 0) %> pts
        </div>
      <% end %>
      <% @game.players.order(:created_at).each do |player| %>
        <% is_active = @game.current_turn && player.id == @game.current_turn %>
        <div class="player-chip <%= 'active-turn' if is_active %>">
          <span class="player-name">
            <%= player.user_id == current_user.id ? "You" : player.user.name %>
            <span class="player-title-badge">· Team <%= player.team.to_i + 1 %></span>
          </span>
          <% if @game_started %>
            <span class="card-count">· <%= (player.hand || []).length %> cards</span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if @is_host %>
      <button class="btn-settings" id="settings-trigger" title="Game settings">⚙</button>
    <% end %>
    <% if @is_host %>
      <%= button_to 'End Game', game_path(@game), method: :delete, class: 'btn-quit',
            form: { data: { turbo_confirm: 'End the game for everyone?' } } %>
    <% else %>
      <%= button_to 'Leave', leave_game_path(@game), method: :post, class: 'btn-quit' %>
    <% end %>
  </header>

  <% if @is_host && !@game_started %>
  <div class="settings-panel" id="settings-panel">
    <div class="settings-panel-inner">
      <p class="settings-heading">Game Settings</p>
      <%= form_with url: update_settings_game_path(@game), method: :patch, data: { turbo: false } do |f| %>
        <label class="toggle-label">
          <%= f.check_box :florida_rules, checked: @game.florida_rules?, class: "toggle-input" %>
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span class="toggle-text">
            Florida Rules
            <span class="toggle-hint">15-card hands and an extra joker per deck.</span>
          </span>
        </label>
        <%= f.submit "Save", class: "btn-settings-save" %>
      <% end %>
    </div>
  </div>
  <% end %>

  <% if !@game_started %>

    <div class="pregame">
      <p>Waiting for players to join… (<%= @game.players.count %>/4)</p>
      <p>Canasta needs exactly 4 players, seated into 2 fixed teams (alternating join order).</p>
      <% if @is_host %>
        <%= button_to 'Start Game', start_game_path(@game), method: :post,
              class: 'btn-start',
              disabled: @game.players.count != 4 %>
      <% else %>
        <p style="opacity:0.5;font-size:0.9rem;">Waiting for the host to start the game…</p>
      <% end %>
    </div>

  <% elsif @canasta&.game_over? %>

    <div class="game-over">
      <h2>Game Over!</h2>
      <ol class="rankings-list">
        <% [0, 1].each do |team| %>
          <li>
            <span class="ranking-title">Team <%= team + 1 %><%= " (you)" if team == my_team %></span>
            <span><%= (@canasta.team_scores || {})[team.to_s] || 0 %> pts</span>
          </li>
        <% end %>
      </ol>
      <p><strong>Team <%= @canasta.winning_team.to_i + 1 %> wins!</strong></p>
      <div class="game-over-actions">
        <%= link_to 'Back to Lobby', games_path, class: 'btn-quit', style: 'display:inline-block;padding:10px 24px;border-radius:6px;text-decoration:none;' %>
      </div>
    </div>

  <% else %>

    <% [opponent_team = 1 - my_team.to_i].each do %>
      <div class="team-melds opponent-melds">
        <p class="hand-label">Opposing team's melds (Team <%= opponent_team + 1 %>)</p>
        <% opp_melds = (@canasta.melds || {})[opponent_team.to_s] || {} %>
        <% if opp_melds.empty? %>
          <p class="pile-info">No melds yet</p>
        <% else %>
          <% opp_melds.each do |rank, cards| %>
            <div class="meld-group <%= 'canasta-complete' if cards.length >= 7 %>">
              <% cards.each do |card| %>
                <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card meld-card" %>
              <% end %>
              <% if cards.length >= 7 %>
                <span class="player-title-badge"><%= cards.none? { |c| c == "jo" || c[1..-1].downcase == "2" } ? "Clean Canasta" : "Dirty Canasta" %></span>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="status-bar">
      <% if my_turn %>
        <span class="your-turn-text">⚡ Your turn! —
          <%= turn_phase == "draw" ? "Draw from the stock, or pick up the discard pile." : "Meld if you can, then discard to end your turn." %>
        </span>
      <% else %>
        Waiting for <strong><%= @current_turn_name %></strong>…
      <% end %>
    </div>

    <% if (lc = @canasta.last_canasta).present? %>
      <div data-last-canasta="true"
           data-canasta-rank="<%= lc["rank"] %>"
           data-canasta-seq="<%= lc["seq"] %>"
           style="display:none;"></div>
    <% end %>

    <% if (fp = (@canasta.foot_pickups || {})[@current_player&.id.to_s]).present? %>
      <div data-foot-pickup="true"
           data-foot-cards="<%= fp["cards"].to_json %>"
           data-foot-seq="<%= fp["seq"] %>"
           style="display:none;"></div>
    <% end %>

    <% if (@canasta.last_draw || {})["cards"].present? %>
      <div data-last-draw="true"
           data-draw-player="<%= @canasta.last_draw["player_id"] %>"
           data-draw-seq="<%= @canasta.last_draw["seq"] %>"
           data-draw-cards="<%= @canasta.last_draw["cards"].to_json %>"
           style="display:none;"></div>
    <% end %>

    <div class="center-table-grid">
      <% if peak_top %>
        <% top_peak = (@canasta.peak_hands || {})[peak_top.id.to_s] %>
        <div class="peak-hand-box peak-top">
          <p class="peak-hand-label"><%= peak_top.user.name %> <span class="player-title-badge">Team <%= peak_top.team.to_i + 1 %></span></p>
          <% if top_peak %>
            <div class="peak-hand-stack"><%= image_tag "cards/blank_card.svg" %></div>
            <p class="peak-hand-count">Peak: <%= top_peak.length %> cards</p>
          <% else %>
            <div class="peak-hand-stack peak-hand-picked-up"><span>✓</span></div>
            <p class="peak-hand-count">Foot picked up</p>
          <% end %>
        </div>
      <% end %>

      <% if peak_left %>
        <% left_peak = (@canasta.peak_hands || {})[peak_left.id.to_s] %>
        <div class="peak-hand-box peak-left">
          <p class="peak-hand-label"><%= peak_left.user.name %> <span class="player-title-badge">Team <%= peak_left.team.to_i + 1 %></span></p>
          <% if left_peak %>
            <div class="peak-hand-stack"><%= image_tag "cards/blank_card.svg" %></div>
            <p class="peak-hand-count">Peak: <%= left_peak.length %> cards</p>
          <% else %>
            <div class="peak-hand-stack peak-hand-picked-up"><span>✓</span></div>
            <p class="peak-hand-count">Foot picked up</p>
          <% end %>
        </div>
      <% end %>

      <div class="piles-center">
        <div class="draw-pile-block">
          <p class="pile-info">Stock: <%= (@canasta.draw_pile || []).length %> cards</p>
          <% if my_turn && turn_phase == "draw" %>
            <%= button_to draw_game_path(@game), method: :post, class: "pile-card-btn", form: { id: "stock-draw-form" } do %>
              <%= image_tag "cards/blank_card.svg", class: "pile-card" %>
            <% end %>
          <% else %>
            <%= image_tag "cards/blank_card.svg", class: "pile-card" %>
          <% end %>
        </div>
        <div class="discard-pile-block">
          <% discard_top = @canasta.discard_pile&.last %>
          <% frozen_by_wild = @canasta.frozen && discard_top && (discard_top == "jo" || discard_top[1..-1]&.downcase == "2" || (@canasta.discard_pile.length > 0 && discard_top[0]&.downcase&.in?(%w[s c]) && discard_top[1..-1]&.downcase == "3")) %>
          <p class="pile-info">Discard <%= frozen_by_wild ? "(frozen ❄)" : "" %></p>
          <% if (@canasta.discard_pile || []).any? %>
            <%= image_tag "cards/#{canasta_card_asset(@canasta.discard_pile.last)}.svg", class: "pile-card" %>
          <% else %>
            <%= image_tag "cards/blank_card.svg", class: "pile-card" %>
          <% end %>
        </div>
      </div>

      <% if peak_right %>
        <% right_peak = (@canasta.peak_hands || {})[peak_right.id.to_s] %>
        <div class="peak-hand-box peak-right">
          <p class="peak-hand-label"><%= peak_right.user.name %> <span class="player-title-badge">Team <%= peak_right.team.to_i + 1 %></span></p>
          <% if right_peak %>
            <div class="peak-hand-stack"><%= image_tag "cards/blank_card.svg" %></div>
            <p class="peak-hand-count">Peak: <%= right_peak.length %> cards</p>
          <% else %>
            <div class="peak-hand-stack peak-hand-picked-up"><span>✓</span></div>
            <p class="peak-hand-count">Foot picked up</p>
          <% end %>
        </div>
      <% end %>

      <% if @current_player %>
        <% my_peak_cards = (@canasta.peak_hands || {})[@current_player.id.to_s] %>
        <% if my_peak_cards %>
          <div class="peak-hand-box peak-mine">
            <p class="peak-hand-label">You <span class="player-title-badge">Team <%= my_team.to_i + 1 %></span></p>
            <div class="peak-hand-stack"><%= image_tag "cards/blank_card.svg" %></div>
            <p class="peak-hand-count">Peak: <%= my_peak_cards.length %> cards</p>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="team-melds my-team-melds">
      <p class="hand-label">Your team's melds (Team <%= my_team.to_i + 1 %>)</p>
      <% my_melds = (@canasta.melds || {})[my_team.to_s] || {} %>
      <% if my_melds.empty? %>
        <p class="pile-info">No melds yet</p>
      <% else %>
        <% my_melds.each do |rank, cards| %>
          <div class="meld-group <%= 'canasta-complete' if cards.length >= 7 %>">
            <% cards.each do |card| %>
              <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card meld-card" %>
            <% end %>
            <% if cards.length >= 7 %>
              <span class="player-title-badge"><%= cards.none? { |c| c == "jo" || c[1..-1].downcase == "2" } ? "Clean Canasta" : "Dirty Canasta" %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="hand-container">
      <p class="hand-label">Your hand</p>
      <div class="canasta-hand-row" id="canasta-hand">
        <% canasta_sort(@current_player.hand).each do |card| %>
          <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card", data: { card: card } %>
        <% end %>
      </div>
      <p class="pile-info" id="meld-selection-info" data-threshold="<%= my_turn && turn_phase == 'discard' ? 0 : 0 %>">
        Selected total: <span id="meld-running-total">0</span> pts
        <% if my_turn %>
          — initial meld for your team needs at least <strong><%= meld_threshold = ((@canasta.team_scores || {})[my_team.to_s].to_i) %></strong> pts
          (threshold scales with score; see status bar)
        <% end %>
      </p>
    </div>

    <% if my_turn %>
      <div class="game-footer" id="canasta-actions" data-turn-phase="<%= turn_phase %>">
        <% if turn_phase == "draw" %>
          <%= form_with url: pickup_discard_game_path(@game), method: :post, html: { id: "pickup-form" } do |f| %>
            <%= f.hidden_field :meld_cards, id: "pickup-cards-input", value: "" %>
            <%= f.submit "Pick Up Pile (with selected cards)", class: "btn-play", id: "pickup-btn" %>
          <% end %>
        <% else %>
          <%= form_with url: meld_game_path(@game), method: :post, html: { id: "meld-form" } do |f| %>
            <%= f.hidden_field :cards, id: "meld-cards-input", value: "" %>
            <%= f.submit "Meld Selected", class: "btn-play", id: "meld-btn" %>
          <% end %>
          <%= form_with url: discard_game_path(@game), method: :post, html: { id: "discard-form" } do |f| %>
            <%= f.hidden_field :card, id: "discard-card-input", value: "" %>
            <%= f.submit "Discard Selected", class: "btn-pass", id: "discard-btn" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

  <% end %>

</div>
