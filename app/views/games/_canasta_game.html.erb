<% my_team       = @current_player&.team %>
<% teammate      = my_team && @game.players.where(team: my_team).where.not(id: @current_player&.id).first %>
<% opponents     = my_team ? @game.players.where.not(team: my_team) : [] %>
<% my_turn       = @game_started && @canasta && !@canasta.game_over? && @game.current_turn == @current_player&.id %>
<% turn_phase    = @canasta&.turn_phase %>

<% other_players = @game.players.where.not(id: @current_player&.id).order(:id).to_a %>
<% peak_left  = other_players[0] %>
<% peak_top   = other_players[1] %>
<% peak_right = other_players[2] %>

<% content_for :nav_left do %>
  <%= render "nav_team_scores", canasta: @canasta, my_team: my_team %>
<% end %>

<% content_for :nav_center do %>
  <%= render "nav_game_info", game: @game, canasta: @canasta, current_player: @current_player, game_started: @game_started, is_host: @is_host, my_turn: my_turn %>
<% end %>

<div class="game-container <%= 'my-turn' if my_turn %>" id="game-container" data-game-id="<%= @game.id %>" data-player-id="<%= @current_player&.id %>" data-card-back="<%= asset_path("cards/backs/#{@game.card_back_key}.jpg") %>">

  <% if @canasta %>
    <div class="round-history-overlay" id="round-history-popup">
      <div class="round-history-modal">
        <button type="button" class="round-history-close" id="round-history-close" aria-label="Close">&times;</button>
        <h3 class="round-history-title">Round-by-Round Scores</h3>

        <% if (@canasta.round_history || []).empty? %>
          <p class="waiting-hint">No rounds completed yet.</p>
        <% else %>
          <table class="round-history-table">
            <thead>
              <tr>
                <th></th>
                <th>Team 1</th>
                <th>Team 2</th>
              </tr>
            </thead>
            <tbody>
              <% @canasta.round_history.each do |entry| %>
                <% t0 = entry["teams"]["0"]; t1 = entry["teams"]["1"] %>
                <tr class="round-history-row">
                  <td>Round <%= entry["round_number"] %></td>
                  <td><%= t0["round_score"] %></td>
                  <td><%= t1["round_score"] %></td>
                </tr>
                <tr class="round-history-detail-row">
                  <td colspan="3">
                    <details class="round-history-detail">
                      <summary>Base &amp; card count</summary>
                      <div class="round-history-detail-grid">
                        <div>
                          <p class="round-history-detail-label">Team 1</p>
                          <div class="round-summary-line"><span>Base score: </span><span><%= t0["base_score"] %></span></div>
                          <div class="round-summary-line"><span>Card count: </span><span><%= t0["card_count"] %></span></div>
                        </div>
                        <div>
                          <p class="round-history-detail-label">Team 2</p>
                          <div class="round-summary-line"><span>Base score: </span><span><%= t1["base_score"] %></span></div>
                          <div class="round-summary-line"><span>Card count: </span><span><%= t1["card_count"] %></span></div>
                        </div>
                      </div>
                    </details>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @is_host && !@game_started %>
  <div class="settings-panel" id="settings-panel">
    <div class="settings-panel-inner">
      <p class="settings-heading">Game Settings</p>
      <%= form_with url: update_settings_game_path(@game), method: :patch, data: { turbo: false } do |f| %>
        <label class="toggle-label">
          <%= f.check_box :florida_rules, checked: @game.florida_rules?, class: "toggle-input" %>
          <span class="toggle-track"><span class="toggle-thumb"></span></span>
          <span class="toggle-text">
            Florida Rules
            <span class="toggle-hint">15-card hands and an extra joker per deck.</span>
          </span>
        </label>
        <%= f.submit "Save", class: "btn-settings-save" %>
      <% end %>
    </div>
  </div>
  <% end %>

  <% if !@game_started %>

    <div class="pregame">
      <p>Waiting for players to join… (<%= @game.players.count %>/4)</p>
      <p>Canasta needs exactly 4 players, seated into 2 fixed teams.</p>

      <div class="team-setup">
        <% [0, 1].each do |team| %>
          <div class="team-setup-column">
            <h4>Team <%= team + 1 %></h4>
            <% @game.players.where(team: team).order(:created_at).each do |player| %>
              <div class="team-setup-player">
                <span><%= player.user.name %><%= " (you)" if player.user_id == current_user.id %></span>
                <% if @is_host %>
                  <%= button_to "Move to T#{2 - team}",
                        set_team_game_path(@game, player_id: player.id, team: 1 - team),
                        method: :post, class: "btn-swap-team" %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @is_host %>
        <%= button_to 'Start Game', start_game_path(@game), method: :post,
              class: 'btn-start',
              disabled: @game.players.count != 4 %>
      <% else %>
        <p style="opacity:0.5;font-size:0.9rem;">Waiting for the host to start the game…</p>
      <% end %>
    </div>

  <% elsif @canasta&.round_summary.present? %>

    <%= render "round_summary", canasta: @canasta, game: @game, is_host: @is_host, my_team: my_team %>

  <% elsif @canasta&.game_over? %>

    <div class="game-over">
      <h2>Game Over!</h2>
      <ol class="rankings-list">
        <% ranked_teams = [0, 1].sort_by { |team| -((@canasta.team_scores || {})[team.to_s] || 0) } %>
        <% ranked_teams.each do |team| %>
          <li class="<%= 'my-team' if team == my_team %>">
            <span class="ranking-title team-name-label" data-team="<%= team + 1 %>">T<%= team + 1 %></span>
            <span><%= (@canasta.team_scores || {})[team.to_s] || 0 %> pts</span>
          </li>
        <% end %>
      </ol>
      <p><strong><span class="team-name-label" data-team="<%= @canasta.winning_team.to_i + 1 %>">T<%= @canasta.winning_team.to_i + 1 %></span> wins!</strong></p>

      <%= render "score_chart", canasta: @canasta %>

      <div class="game-over-actions">
        <%= link_to 'Back to Lobby', games_path, class: 'btn-quit', style: 'display:inline-block;padding:10px 24px;border-radius:6px;text-decoration:none;' %>
      </div>
    </div>

  <% else %>

    <% opponent_team = 1 - my_team.to_i %>

    <% if (lc = @canasta.last_canasta).present? %>
      <div data-last-canasta="true"
           data-canasta-rank="<%= lc["rank"] %>"
           data-canasta-seq="<%= lc["seq"] %>"
           style="display:none;"></div>
    <% end %>

    <% if (fp = (@canasta.foot_pickups || {})[@current_player&.id.to_s]).present? %>
      <div data-foot-pickup="true"
           data-foot-cards="<%= fp["cards"].to_json %>"
           data-foot-seq="<%= fp["seq"] %>"
           style="display:none;"></div>
    <% end %>

    <% if (@canasta.last_draw || {})["cards"].present? %>
      <div data-last-draw="true"
           data-draw-player="<%= @canasta.last_draw["player_id"] %>"
           data-draw-seq="<%= @canasta.last_draw["seq"] %>"
           data-draw-cards="<%= @canasta.last_draw["cards"].to_json %>"
           style="display:none;"></div>
    <% end %>

    <% if (@canasta.last_pickup || {})["cards"].present? %>
      <div data-last-pickup="true"
           data-pickup-player="<%= @canasta.last_pickup["player_id"] %>"
           data-pickup-seq="<%= @canasta.last_pickup["seq"] %>"
           data-pickup-cards="<%= @canasta.last_pickup["cards"].to_json %>"
           style="display:none;"></div>
    <% end %>

    <div class="table-row">
      <div class="my-melds-col">
        <%= render "canasta_area",
              team_num: my_team.to_i,
              melds: ((@canasta.melds || {})[my_team.to_s] || {}),
              red_threes: ((@canasta.red_threes || {})[my_team.to_s] || []) %>
      </div>

      <div class="piles-col">
        <% peak_hands = @canasta.peak_hands || {} %>
        <% left_peaks  = [peak_left, peak_top].compact.select { |p| peak_hands[p.id.to_s] } %>
        <% right_peaks = [peak_right, @current_player].compact.select { |p| peak_hands[p.id.to_s] } %>
        <div class="piles-with-flanks">
          <% if left_peaks.any? %>
            <div class="peak-hand-flank">
              <% left_peaks.each do %>
                <div class="peak-hand-box">
                  <div class="peak-hand-stack"><%= image_tag "cards/blank_card.svg" %></div>
                </div>
              <% end %>
            </div>
          <% end %>
        <div class="piles-center">
          <% pending_red_three_draws = (@canasta.pending_red_three_draws || {})[@current_player&.id.to_s].to_i %>
          <div class="draw-pile-block">
            <% if pending_red_three_draws > 0 %>
              <%# Red three replacement takes priority — the stock pile is only
                  active for this one card, regardless of whose turn it is. %>
              <%= button_to draw_red_three_replacement_game_path(@game), method: :post, class: "pile-card-btn meld-hoverable", form: { id: "stock-draw-form" } do %>
                <%= image_tag "cards/blank_card.svg", class: "pile-card pile-card-red-three-pending", title: "Draw your red three replacement" %>
                <%= render "pile_count_overlay", text: "Draw replacement" %>
              <% end %>
            <% elsif my_turn && turn_phase == "draw" %>
              <%= button_to draw_game_path(@game), method: :post, class: "pile-card-btn meld-hoverable", form: { id: "stock-draw-form" } do %>
                <%= image_tag "cards/blank_card.svg", class: "pile-card", title: "#{(@canasta.draw_pile || []).length} cards" %>
                <%= render "pile_count_overlay", text: (@canasta.draw_pile || []).length %>
              <% end %>
            <% else %>
              <div class="stock-pile-wrapper meld-hoverable">
                <%= image_tag "cards/blank_card.svg", class: "pile-card" %>
                <%= render "pile_count_overlay", text: (@canasta.draw_pile || []).length %>
              </div>
            <% end %>
          </div>
          <div class="discard-pile-block meld-hoverable" id="discard-pile-drop">
            <% discard_top = @canasta.discard_pile&.last %>
            <% frozen_by_wild = @canasta.frozen && discard_top && (discard_top == "jo" || discard_top[1..-1]&.downcase == "2" || (@canasta.discard_pile.length > 0 && discard_top[0]&.downcase&.in?(%w[s c]) && discard_top[1..-1]&.downcase == "3")) %>
            <% if (@canasta.discard_pile || []).any? %>
              <%= image_tag "cards/#{canasta_card_asset(@canasta.discard_pile.last)}.svg", class: "pile-card #{'pile-card-frozen' if frozen_by_wild}", title: frozen_by_wild ? "Frozen ❄" : nil %>
            <% else %>
              <div class="pile-card pile-card-empty">∅</div>
            <% end %>
            <%= render "pile_count_overlay", text: (@canasta.discard_pile || []).length %>
          </div>
        </div>
          <% if right_peaks.any? %>
            <div class="peak-hand-flank">
              <% right_peaks.each do %>
                <div class="peak-hand-box">
                  <div class="peak-hand-stack"><%= image_tag "cards/blank_card.svg" %></div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div><%# piles-with-flanks %>
      </div>

      <div class="opp-melds-col">
        <%= render "canasta_area",
              team_num: opponent_team,
              melds: ((@canasta.melds || {})[opponent_team.to_s] || {}),
              red_threes: ((@canasta.red_threes || {})[opponent_team.to_s] || []),
              opponent: true %>
      </div>
    </div>


    <div class="hand-container">
      <div class="canasta-hand-row" id="canasta-hand">
        <% canasta_sort(@current_player.hand).each do |card| %>
          <div class="hand-card-wrap" data-card="<%= card %>">
            <%= image_tag "cards/#{canasta_card_asset(card)}.svg", class: "game-card", draggable: "false" %>
          </div>
        <% end %>
      </div>
      <p class="pile-info" id="meld-selection-info">
        Selected total: <span id="meld-running-total">0</span> pts
        <% unless @canasta.team_melded?(my_team) %>
          — your team's first meld needs at least <strong><%= @canasta.meld_threshold(my_team) %></strong> pts
        <% end %>
      </p>
    </div>

    <%# Playing a red three isn't gated by whose turn it is, so this form is
        always available regardless of my_turn/turn_phase. %>
    <%= form_with url: play_red_three_game_path(@game), method: :post, html: { id: "red-three-form", style: "display:none;" } do |f| %>
      <%= f.hidden_field :cards, id: "red-three-cards-input", value: "" %>
    <% end %>

    <% if my_turn && turn_phase == "draw" %>
      <%= form_with url: pickup_discard_game_path(@game), method: :post, html: { id: "pickup-form", style: "display:none;" } %>
    <% end %>

    <% if my_turn && turn_phase != "draw" %>
      <%= form_with url: meld_game_path(@game), method: :post, html: { id: "meld-form", style: "display:none;" } do |f| %>
        <%= f.hidden_field :cards, id: "meld-cards-input", value: "" %>
        <%= f.hidden_field :target_rank, id: "meld-target-rank-input", value: "" %>
      <% end %>
      <%= form_with url: discard_game_path(@game), method: :post, html: { id: "discard-form", style: "display:none;" } do |f| %>
        <%= f.hidden_field :card, id: "discard-card-input", value: "" %>
      <% end %>
    <% end %>
  <% end %>

</div>
