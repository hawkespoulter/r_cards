<div class="card flex-container">
  <div>Name of game:<%= game.game_type %></div>
  <ul>
    <% players.each do |player| %>
      <li><%= player.user.name %></li>
    <% end %>
  </ul>
  <%= form_with(url: join_game_path(game), method: :post, local: true) do |form| %>
    <%= form.submit 'Join' %>
  <% end %>
  <%= button_to 'Delete', game_path(game), method: :delete, class: 'danger' %>
</div>