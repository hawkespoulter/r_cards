<div class="lobby-card">
  <p class="lobby-card-title">♠ <%= game.game_type.titleize %></p>
  <p class="lobby-card-date"><%= game.created_at.strftime("%b") %> <%= game.created_at.day %></p>

  <% if game.canasta? %>
    <% team_scores = game.canasta&.team_scores || {} %>
    <div class="lobby-teams">
      <% [0, 1].each do |team| %>
        <div class="lobby-team">
          <p class="lobby-team-name"><%= game.team_name(team) %>: <%= team_scores[team.to_s] || 0 %></p>
          <ul class="lobby-players">
            <% team_players = players.select { |p| p.team.to_i == team } %>
            <% if team_players.any? %>
              <% team_players.each do |player| %>
                <li><%= player.user.name %></li>
              <% end %>
            <% else %>
              <li style="opacity:0.5">No players yet</li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% else %>
    <ul class="lobby-players">
      <% if players.any? %>
        <% players.each do |player| %>
          <li><%= player.user.name %></li>
        <% end %>
      <% else %>
        <li style="opacity:0.5">No players yet</li>
      <% end %>
    </ul>
  <% end %>

  <div class="lobby-actions">
    <% in_this_game = game.players.any? { |p| p.user_id == current_user.id } %>
    <% if in_this_game %>
      <%= link_to 'Enter', game_path(game), class: 'btn-join' %>
    <% else %>
      <%= form_with url: join_game_path(game), method: :post, data: { turbo: false } do |form| %>
        <%= form.submit 'Join', class: 'btn-join' %>
      <% end %>
    <% end %>
    <% if game.players.order(:created_at).first&.user_id == current_user.id %>
      <%= button_to 'Delete', game_path(game), method: :delete, class: 'btn-quit',
            form: { data: { turbo_confirm: 'Delete this game?' } } %>
    <% end %>
  </div>
</div>
