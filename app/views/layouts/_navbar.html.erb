<nav>
  <ul>
    <% if content_for?(:nav_left) %>
      <li class="nav-left">
        <%= yield :nav_left %>
      </li>
    <% end %>
    <% if content_for?(:nav_center) %>
      <li class="nav-center">
        <%= yield :nav_center %>
      </li>
    <% end %>
    <li class="nav-right">
      <% unless user_signed_in? %>
        <div class="profile-menu" id="test-accounts-menu">
          <button class="profile-trigger" id="test-accounts-trigger" aria-expanded="false">
            <span class="profile-name">🧪 Test Login</span>
            <span class="profile-caret">▾</span>
          </button>
          <div class="profile-dropdown" id="test-accounts-dropdown">
            <div class="dropdown-header">
              <span class="dropdown-name">Quick sign-in</span>
            </div>
            <div class="dropdown-divider"></div>
            <% [["dog@dog.com","dogdog","Dog"], ["cat@cat.com","catcat","Cat"], ["boy@boy.com","boyboy","Boy"]].each do |email, pass, label| %>
              <%= form_with url: user_session_path, method: :post, data: { turbo: false }, class: "test-login-form" do |f| %>
                <input type="hidden" name="user[email]" value="<%= email %>">
                <input type="hidden" name="user[password]" value="<%= pass %>">
                <button type="submit" class="dropdown-item">Sign in as <strong><%= label %></strong></button>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if user_signed_in? %>
        <div class="color-picker-menu" id="color-picker-menu">
          <button class="bug-report-trigger" id="color-picker-trigger" title="Game settings">⚙</button>
          <div class="color-picker-dropdown" id="color-picker-dropdown">
            <div class="dropdown-header"><span class="dropdown-name">Game Settings</span></div>
            <div class="dropdown-divider"></div>
            <div class="color-team-row">
              <span class="color-team-label">Card Back</span>
              <div class="card-back-options card-back-options-inline" id="navbar-card-back-options">
                <% Game::CARD_BACKS.each do |key, label| %>
                  <button class="card-back-option-btn"
                          data-back-key="<%= key %>"
                          data-back-src="<%= asset_path("cards/backs/#{key}.jpg") %>"
                          title="<%= label %>">
                    <%= image_tag "cards/backs/#{key}.jpg", class: "card-back-thumb-sm" %>
                  </button>
                <% end %>
              </div>
            </div>
            <div class="dropdown-divider"></div>
            <div class="color-team-row">
              <span class="color-team-label">Team 1 Name</span>
              <input type="text" class="team-name-input" data-team="1" placeholder="Team 1" maxlength="14">
            </div>
            <div class="color-team-row">
              <span class="color-team-label">Team 2 Name</span>
              <input type="text" class="team-name-input" data-team="2" placeholder="Team 2" maxlength="14">
            </div>
          </div>
        </div>

        <button class="bug-report-trigger" id="bug-report-trigger" title="Report a bug">🐛</button>

        <div class="profile-menu">
          <button class="profile-trigger avatar-only" id="profile-trigger" aria-expanded="false">
            <span class="profile-avatar"><%= current_user.name&.first&.upcase || "?" %></span>
          </button>
          <div class="profile-dropdown" id="profile-dropdown">
            <div class="dropdown-header">
              <span class="dropdown-name"><%= current_user.name %></span>
              <span class="dropdown-email"><%= current_user.email %></span>
            </div>
            <div class="dropdown-divider"></div>
            <%= link_to 'Edit Profile', edit_user_registration_path, class: 'dropdown-item' %>
            <%= link_to 'Bug Tracker', bugs_path, class: 'dropdown-item' %>
            <%= link_to 'Sign Out', destroy_user_session_path,
                  data: { "turbo-method": :delete },
                  class: 'dropdown-item dropdown-item-danger' %>
          </div>
        </div>
      <% end %>
    </li>
  </ul>
</nav>

<!-- Bug report modal -->
<% if user_signed_in? %>
  <div class="bug-modal-overlay" id="bug-modal-overlay">
    <div class="bug-modal" id="bug-modal">
      <div class="bug-modal-header">
        <span>🐛 Report a Bug</span>
        <button class="bug-modal-close" id="bug-modal-close">✕</button>
      </div>
      <%= form_with url: bugs_path, method: :post, data: { turbo: false }, html: { class: "bug-modal-form" } do |f| %>
        <%= f.text_area :description, name: "bug[description]",
              placeholder: "Describe what happened…",
              class: "bug-textarea",
              rows: 4 %>
        <div class="bug-modal-actions">
          <%= f.submit "Submit", class: "btn-create" %>
          <%= link_to bugs_path, class: "btn-view-bugs" do %>View all bugs<% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Profile dropdown
    const trigger  = document.getElementById("profile-trigger");
    const dropdown = document.getElementById("profile-dropdown");
    if (trigger) {
      trigger.addEventListener("click", function (e) {
        e.stopPropagation();
        const open = dropdown.classList.toggle("open");
        trigger.setAttribute("aria-expanded", open);
      });
      document.addEventListener("click", function () {
        dropdown.classList.remove("open");
        trigger.setAttribute("aria-expanded", false);
      });
    }

    // Test accounts dropdown
    const testTrigger  = document.getElementById("test-accounts-trigger");
    const testDropdown = document.getElementById("test-accounts-dropdown");
    if (testTrigger) {
      testTrigger.addEventListener("click", function (e) {
        e.stopPropagation();
        const open = testDropdown.classList.toggle("open");
        testTrigger.setAttribute("aria-expanded", open);
      });
      document.addEventListener("click", function () {
        testDropdown.classList.remove("open");
        testTrigger.setAttribute("aria-expanded", false);
      });
    }

    // Bug modal
    const bugTrigger = document.getElementById("bug-report-trigger");
    const bugOverlay = document.getElementById("bug-modal-overlay");
    const bugClose   = document.getElementById("bug-modal-close");

    if (bugTrigger && bugOverlay) {
      bugTrigger.addEventListener("click", function (e) {
        e.stopPropagation();
        bugOverlay.classList.add("open");
      });
      bugClose.addEventListener("click", function () {
        bugOverlay.classList.remove("open");
      });
      bugOverlay.addEventListener("click", function (e) {
        if (e.target === bugOverlay) bugOverlay.classList.remove("open");
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") bugOverlay.classList.remove("open");
      });
    }

    // Team settings (names)
    function applyTeamSettings() {
      const n1 = localStorage.getItem("r_cards_team1_name") || "";
      const n2 = localStorage.getItem("r_cards_team2_name") || "";

      // Apply team names
      document.querySelectorAll(".team-name-label[data-team]").forEach(el => {
        const name = el.dataset.team === "1" ? n1 : n2;
        el.textContent = name || "T" + el.dataset.team;
      });
      // Score chip name labels (no data-team on the span, use parent chip)
      document.querySelectorAll(".team-score-chip[data-team] .team-name-label").forEach(el => {
        const team = el.closest("[data-team]").dataset.team;
        const name = team === "1" ? n1 : n2;
        el.textContent = name || "T" + team;
      });

      // Sync name inputs
      document.querySelectorAll(".team-name-input[data-team='1']").forEach(i => { if (document.activeElement !== i) i.value = n1; });
      document.querySelectorAll(".team-name-input[data-team='2']").forEach(i => { if (document.activeElement !== i) i.value = n2; });
    }

    // Card back picker
    function applyCardBack() {
      const saved = localStorage.getItem("r_cards_card_back");
      document.querySelectorAll("#navbar-card-back-options .card-back-option-btn").forEach(btn => {
        btn.classList.toggle("active", btn.dataset.backSrc === saved);
      });
      if (saved) {
        document.querySelectorAll("img.pile-card, .peak-hand-stack img").forEach(img => {
          if (img.src.includes("blank_card")) img.src = saved;
        });
      }
    }

    const cardBackOptions = document.getElementById("navbar-card-back-options");
    if (cardBackOptions) {
      cardBackOptions.addEventListener("click", function (e) {
        e.stopPropagation();
        const btn = e.target.closest(".card-back-option-btn");
        if (!btn) return;
        localStorage.setItem("r_cards_card_back", btn.dataset.backSrc);
        applyCardBack();
      });
    }

    const colorTrigger  = document.getElementById("color-picker-trigger");
    const colorDropdown = document.getElementById("color-picker-dropdown");
    if (colorTrigger) {
      applyCardBack();
      applyTeamSettings();
      colorTrigger.addEventListener("click", function (e) {
        e.stopPropagation();
        colorDropdown.classList.toggle("open");
      });
      document.addEventListener("click", function () { colorDropdown.classList.remove("open"); });
      document.querySelectorAll(".team-name-input").forEach(function (input) {
        input.addEventListener("input", function () {
          localStorage.setItem("r_cards_team" + input.dataset.team + "_name", input.value.trim());
          applyTeamSettings();
        });
        input.addEventListener("click", function (e) { e.stopPropagation(); });
      });
    }
  });
</script>
